# ═════════════════════════════════════════════════════════════════════════════
#  Einstellungen der MES-Demo-Umgebung
# ═════════════════════════════════════════════════════════════════════════════
#
#  start.sh legt diese Datei beim ersten Start aus .env.example an. Sie enthält
#  nichts Serverspezifisches und kann unverändert auf einen anderen Server umziehen.
#
#  So wird eine Änderung wirksam:
#    ./start.sh              – übernimmt alle Werte; nur Container mit geänderter
#                              Einstellung werden neu erstellt (≈ 30 s), Oracle bleibt
#    ./start.sh optimiert    – setzt zusätzlich KONFIG=optimiert
#  Der Autostart nach einem Reboot verwendet ebenfalls diese Werte.
#
#  Die Kommentare nennen jeweils
#    Wirkung   – was sich im System ändert
#    Kunde     – wie es im Produktivsystem aussieht (Quelle: resosurcen-vom-kunden/)
#    Zeigen    – Szenario in workshop/Demo-Szenarien.md, in dem der Wert eine Rolle spielt
#
#  Hinweis: Kommentare immer in eigene Zeilen schreiben, nicht hinter einen Wert.
# ═════════════════════════════════════════════════════════════════════════════


# ─── Netzwerk ────────────────────────────────────────────────────────────────

# Port des Portals: ein Eingang für alle Weboberflächen, verteilt nach Pfad
# (/frontend/, /grafana/, /prometheus/, /haproxy, /cadvisor/, /core/ …).
# Wirkung: Nur dieser eine Port muss erreichbar sein, damit Teilnehmer an
#          Dashboards und Laststeuerung kommen. Die Einzelports (3000, 9090,
#          8070 …) bleiben zusätzlich offen und funktionieren unverändert.
#          Regeln: portal/nginx.conf, Übersichtsseite: portal/index.html
# Leer oder 8080 = Standard. Ein anderer Wert wird von start.sh mit in der
#          Firewall freigegeben; Grafana und Prometheus bauen ihre Links damit.
PORTAL_PORT=8080

# Von außen erreichbare IP oder Hostname der Demo-VM.
# Wirkung: wird als -Djava.rmi.server.hostname an alle TomEE-Container übergeben.
#          JMX über RMI meldet dem Client diese Adresse zurück; stimmt sie nicht,
#          scheitert JConsole/VisualVM nach dem ersten Verbindungsaufbau.
# Kunde:   -Djava.rmi.server.hostname=zzux135 bzw. zzux144
# Am einfachsten über den Parameter setzen: ./start.sh --host 20.224.241.62
#          Das trägt den Wert hier ein und er gilt auch nach einem Reboot.
# Leer lassen, wenn der Server direkt unter seiner eigenen IP erreichbar ist:
#          start.sh nimmt dann die erste IP aus "hostname -I", in einer Cloud die
#          öffentliche Adresse aus dem Metadatendienst, sofern sie dort steht.
#          Hängt die öffentliche Adresse an einem Load Balancer statt an der
#          Netzwerkkarte, kennt der Metadatendienst sie nicht – dann --host nutzen.
REMOTE_HOST=

# ─── Konfigurationsvariante ──────────────────────────────────────────────────

# Welche tomee.xml und server.xml die TomEE-Container bekommen.
#   kunde     = Dateien des Kunden, nur Datenbank-URL, User und Passwort angepasst.
#               Alle Pools, Timeouts und Executoren wie in Produktion.
#   optimiert = Tuning-Vorschlag (tomee/konfig/optimiert/), jede Abweichung ist dort
#               mit TUNING und dem Kundenwert kommentiert. Unter anderem:
#               Wartezeit auf eine Connection 5 s statt 30 s, Bean-Pool-Wartezeit 5 s
#               statt 30 s, Oracle-ReadTimeout 5 min statt 60 min, Transaction
#               Timeout 15 min statt 4 h, HTTP-Threads 100 mit Warteschlange 200,
#               BatchHandling fest 16 Threads statt 100…10000.
# Zeigen:  Modul G (Vorher/Nachher) – S01, S02, S03 mit beiden Varianten vergleichen
KONFIG=kunde

# Zusätzlicher Facade-Container (Heap-Max über dem Container-Limit, JMX-Port-Fehler).
#   leer   = ohne Facade
#   facade = mit Facade
# Wird von start.sh gesetzt: "./start.sh kunde --facade" schaltet ein,
# "./start.sh kunde" (ohne --facade) wieder aus. Docker Compose liest den Wert direkt.
# Zeigen:  S09
COMPOSE_PROFILES=


# ─── Scheduler ───────────────────────────────────────────────────────────────

# Anzahl der Threads für ALLE EJB-Timer einer JVM (TomEE-Property openejb.timer.pool.size).
# Wirkung: TomEE führt @Schedule- und TimerService-Timer intern über Quartz aus.
#          Alle Timer der Anwendung teilen sich diese Threads. Sind sie durch lange
#          oder hängende Läufe belegt, startet kein Timer mehr – ohne Fehlermeldung.
# Leer:    TomEE-Default 3 Threads.
# Kunde:   unbekannt (offene Frage: ist „erhöht von 1/5 auf 10" dieser Wert?)
# Zeigen:  S06 – mit 3 steht der Heartbeat nach drei hängenden Läufen,
#          mit z. B. 10 hält er länger durch, das Grundproblem bleibt.
TIMER_POOL_SIZE=

# Anzahl der Threads des eigenständigen Quartz-Schedulers der Demo-Anwendung
# (org.quartz.threadPool.threadCount).
# Wirkung: Wie viele Quartz-Jobs gleichzeitig laufen können. Sind alle belegt,
#          verschieben sich die Termine; nach mehr als 60 s zählt Quartz Misfires.
# Kunde:   Quartz-Konfiguration liegt nicht vor.
# Zeigen:  S06 (Quartz tickt weiter, solange ein Thread frei ist; Misfires bei timer=quartz)
QUARTZ_THREADS=5


# ─── Schnittstellen und Transaktionen ────────────────────────────────────────

# Lese-Timeout der TCP-Socket-Schnittstelle im FileProcessing (Ports 50000–50004),
# in Millisekunden. 0 = unbegrenzt.
# Wirkung: Jede offene Verbindung belegt einen Thread aus dem SocketHandler-Pool
#          (250 Threads) und einen File Descriptor. Ohne Timeout halten Clients, die
#          nichts mehr senden, beides für immer fest. Mit z. B. 30000 gibt der
#          Server die Verbindung nach 30 s Stille frei.
# Kunde:   unbekannt – im Workshop nachfragen.
# Zeigen:  S10 (stille Socket-Clients belegen Threads und File Descriptors)
SOCKET_TIMEOUT_MS=0

# Ab welcher Laufzeit (Sekunden) eine noch offene Transaktion ins Log geschrieben
# und in der Metrik mes_transaktionen_ueberschwelle gezählt wird.
# Wirkung: Nur Beobachtung – die Transaktion läuft unverändert weiter.
#          Log: "Transaktion läuft seit … s (Schwelle … s): <Bean.Methode>, Thread …"
# Kunde:   Wunsch „Transaction Timeouts loggen, länger als eine Stunde ist ein Problem";
#          der eingestellte Transaction Timeout ist 14400 s (4 h).
#          Für den Produktivbetrieb wäre 3600 ein naheliegender Startwert.
# Zeigen:  S07
TX_WARN_SEKUNDEN=60


# ─── CPU ─────────────────────────────────────────────────────────────────────

# CPU-Kerne, die jeder TomEE-Container höchstens nutzen darf (docker --cpus).
# Wirkung: Die JVM sieht diese Zahl als verfügbare Prozessoren; danach richten sich
#          z. B. GC- und JIT-Threads. Wird das Kontingent überschritten, drosselt der
#          Kernel den Container (Dashboard 5: CPU-Drosselung).
# Kunde:   kein CPU-Limit im docker run; alle Container eines Hosts teilen sich
#          4 Kerne (kleinere Standorte: 2).
TOMEE_CPUS=2


# ─── JVM-Optionen ────────────────────────────────────────────────────────────

# Zusätzliche JVM-Optionen für alle TomEE-Container, z. B. für die Nachanalyse:
#   GC-Log:          -Xlog:gc*:file=/opt/apache-tomee-plume-10.1.2/logs/gc.log:time,uptime
#   Heap-Dump:       -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/apache-tomee-plume-10.1.2/logs
#   Off-Heap-Grenze: -XX:MaxDirectMemorySize=256m   (Default = -Xmx)
#   Speicherkarte:   -XX:NativeMemoryTracking=summary  (Abfrage: jcmd 1 VM.native_memory)
# Kunde:   keine dieser Optionen gesetzt (Empfehlung: GC-Log und Heap-Dump aktivieren).
JAVA_OPTS_EXTRA=


# ─── Heap und Container-Speicher ─────────────────────────────────────────────
#
#  *_XMS / *_XMX = Start- und Maximalgröße des Java-Heaps (-Xms / -Xmx)
#  *_MEM         = Speicherlimit des Containers (docker run -m)
#
#  Die Werte sind kleiner als beim Kunden, das VERHÄLTNIS Heap zu Limit ist aber
#  nachgebildet. Außerhalb des Heaps braucht die JVM zusätzlich Speicher für
#  Metaspace, Threads, Code Cache und Off-Heap-Puffer – bei TomEE mehrere hundert MB.
#  Wird das Limit überschritten, beendet der Kernel den Prozess (Exit 137) ohne
#  OutOfMemoryError. Da kein --memory-swap gesetzt ist (wie beim Kunden), darf jeder
#  Container zusätzlich Swap in Höhe seines Limits nutzen.

# Core – Kunde: -Xms4096M -Xmx7168M bei -m 10g → Heap = 70 % des Limits.
#        Demo: 1024 von 1500 MB = 68 %. Genug Luft für den Normalbetrieb.
CORE_XMS=512m
CORE_XMX=1024m
CORE_MEM=1500m

# FileProcessing – Kunde: -Xms5120M -Xmx8192M bei -m 12g → 67 %. Demo: 68 %.
FP_XMS=512m
FP_XMX=1024m
FP_MEM=1500m

# Maximale Zahl offener Dateien und Sockets im FileProcessing (ulimit -n).
# Wirkung: Grenze für OpenFileDescriptorCount; bei Erreichen „Too many open files".
#          Bewusst niedrig, damit das Verhältnis „offen zu Limit" sichtbar wird.
#          Die anderen Container nutzen den Docker-Default (hier 524288).
# Kunde:   unbekannt – Frage „OpenFileDescriptor 440 gut? 500 gut?" lässt sich erst
#          mit dem Limit beantworten.
# Zeigen:  S10
FP_NOFILE=4096

# Singleton – Kunde: -Xms4048M -Xmx4500M bei -m 5000m → 90 %, nur ~500 MB für alles
#             außerhalb des Heaps. Demo: 1024 von 1150 MB = 89 %, ebenso knapp.
SINGLETON_XMS=512m
SINGLETON_XMX=1024m
SINGLETON_MEM=1150m

# Facade (nur mit COMPOSE_PROFILES=facade) – Kunde: -Xms4096M -Xmx7168M bei -m 2000m
#         → der Heap darf 3,6-mal so groß werden wie das Limit.
#         Demo: 2500 bei 700 MB = 3,6-fach, derselbe Fehler.
# Zeigen: S09 – der Container wird bei ca. 800 MB belegtem Heap vom Kernel beendet
#         und durch die Restart-Policy neu gestartet.
FACADE_XMS=256m
FACADE_XMX=2500m
FACADE_MEM=700m
